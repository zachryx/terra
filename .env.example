# Database
DATABASE_URL="postgresql://user:password@localhost:5432/terra"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
NODE_ENV="development"
PORT=3000

# CORS
CORS_ORIGIN="http://localhost:5173"

# SSO - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# SSO - Facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:3000/api/v1/auth/facebook/callback"

# Email (for future implementation)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@terra.com"

# Orders
ORDER_HOLD_MINUTES=15
DEFAULT_CURRENCY="USD"

# Payments: "fake" (default; no account needed) or "stripe"
PAYMENT_PROVIDER="fake"
FAKE_WEBHOOK_SECRET="dev-fake-webhook-secret"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Signs QR ticket codes. Generate with: openssl rand -hex 32
TICKET_SIGNING_SECRET="change-me"

# Frontend base URL used in email links and the Google OAuth redirect
FRONTEND_URL="http://localhost:5173"

# Mail: "log" (default, prints to console) or "smtp" (e.g. Mailpit from docker-compose)
MAIL_PROVIDER="log"

# Rate limiting (requests per minute per IP). Strict applies to login, register,
# password flows and checkout.
THROTTLE_LIMIT=120
STRICT_THROTTLE_LIMIT=10
# Set to 1 when running behind a reverse proxy so client IPs are correct
TRUST_PROXY=
